                                    }
                                  ]
                                },
                                {
                                  "type": "text",
                                  "id": "Khpwy",
                                  "name": "selectedText",
                                  "fill": "#3F3F46",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "A single X-ray image can't cleanly tell how much \"blocking\" is coming from bone versus muscle/fat. DEXA solves this by using dual-energy X-rays:",
                                  "lineHeight": 1.7,
                                  "fontFamily": "Inter",
                                  "fontSize": 15,
                                  "fontWeight": "normal"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "H5wV1",
                              "name": "bulletList",
                              "width": "fill_container",
                              "layout": "vertical",
                              "gap": 10,
                              "padding": [
                                0,
                                0,
                                0,
                                20
                              ],
                              "children": [
                                {
                                  "type": "frame",
                                  "id": "6ra8p",
                                  "name": "li1",
                                  "width": "fill_container",
                                  "gap": 12,
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "A1FfF",
                                      "name": "bullet1",
                                      "fill": "#71717A",
                                      "content": "•",
                                      "fontFamily": "Inter",
                                      "fontSize": 15,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "9Er6O",
                                      "name": "li1Text",
                                      "fill": "#3F3F46",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "The machine emits two X-ray spectra (a \"lower-energy\" and a \"higher-energy\" beam).",
                                      "lineHeight": 1.7,
                                      "fontFamily": "Inter",
                                      "fontSize": 15,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "DV3LP",
                                  "name": "li2",
                                  "width": "fill_container",
                                  "gap": 12,
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "WRqUG",
                                      "name": "bullet2",
                                      "fill": "#71717A",
                                      "content": "•",
                                      "fontFamily": "Inter",
                                      "fontSize": 15,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "xmQ3q",
                                      "name": "li2Text",
                                      "fill": "#3F3F46",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "Bone (rich in calcium, higher atomic number) absorbs X-rays much more strongly, especially at lower energies.",
                                      "lineHeight": 1.7,
                                      "fontFamily": "Inter",
                                      "fontSize": 15,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "hTeO9",
                                  "name": "li3",
                                  "width": "fill_container",
                                  "gap": 12,
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "La3Co",
                                      "name": "bullet3",
                                      "fill": "#71717A",
                                      "content": "•",
                                      "fontFamily": "Inter",
                                      "fontSize": 15,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "kSicP",
                                      "name": "li3Text",
                                      "fill": "#3F3F46",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "Soft tissue (fat and lean tissue) absorbs X-rays less and with a different energy dependence.",
                                      "lineHeight": 1.7,
                                      "fontFamily": "Inter",
                                      "fontSize": 15,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "bvhC1",
                              "name": "para2",
                              "fill": "#3F3F46",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Because attenuation (weakening of the beam) depends on both material and X-ray energy, the scanner can use the difference between the two measurements to mathematically \"separate\":",
                              "lineHeight": 1.7,
                              "fontFamily": "Inter",
                              "fontSize": 15,
                              "fontWeight": "normal"
                            }
                          ]
                        }
